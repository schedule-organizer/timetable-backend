# Copy to .env and adjust. Every value below has a working default in docker-compose.yml, so this
# file is only needed to change them — a fresh clone runs without it.
#
#   cp .env.example .env

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=schediflow
POSTGRES_USER=schediflow
POSTGRES_PASSWORD=schediflow
POSTGRES_PORT=5432

# Used when running the app outside Docker against the compose database. This is already the
# default, so it only needs setting to point somewhere else.
POSTGRES_URL=jdbc:postgresql://localhost:5432/schediflow

# ── Spring profiles ───────────────────────────────────────────────────────────
# PostgreSQL is the default datasource; no profile is needed for it.
# demo            seed the 21-class demo school on startup
# prod            disable Swagger, open-in-view off
# Combine with commas. Empty is the normal case.
SPRING_PROFILES_ACTIVE=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Base64-encoded, at least 32 bytes. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=Y2hhbmdlLXRoaXMtaW4tcHJvZHVjdGlvbi1hdC1sZWFzdC0zMi1ieXRlcw==

# ── Mail ──────────────────────────────────────────────────────────────────────
# Compose points these at MailHog and sets MAIL_ENABLED=true for you; read the mail it sends at
# http://localhost:8025. Outside Docker, mail stays stubbed unless MAIL_ENABLED=true.
MAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@schediflow.local

# ── Frontend / CORS ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Calendarific ──────────────────────────────────────────────────────────────
# Public holiday import (POST /api/v1/holidays/import). Without a key that endpoint returns 400;
# nothing else is affected. Free tier: https://calendarific.com
CALENDARIFIC_API_KEY=
